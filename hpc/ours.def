Bootstrap: docker
From: ubuntu:22.04
# 114 "ours" image (task 006, deviation 11): the lpc uv project, installed from the SAME uv.lock (`uv sync --frozen`):
# torch 2.7.1+cu126 / torchvision 0.22.1+cu126 (bundled CUDA), sam-2 @ 2b90b9f (SAM2_BUILD_CUDA=0), transformers 4.57.1,
# open_clip_torch 3.3.0, numpy <2, scipy, scikit-learn, open3d, PyYAML, Pillow. Code is NOT baked in (repo snapshot per
# job, PYTHONPATH); weights are NOT baked in ($PROJ/models, bound at <code>/data/models).
# Build on the PERUN login node: hpc/build_ours.sh (apptainer build --fakeroot), from the repo root (needs %files).

%files
    pyproject.toml /opt/ours-src/pyproject.toml
    uv.lock /opt/ours-src/uv.lock

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONUNBUFFERED=1

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl git build-essential \
        libgl1 libegl1 libglib2.0-0 libgomp1 libx11-6 libxext6 libsm6 libxrender1 libusb-1.0-0
    rm -rf /var/lib/apt/lists/*
    curl -LsSf https://astral.sh/uv/0.12.19/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv SAM2_BUILD_CUDA=0
    uv python install 3.11
    cd /opt/ours-src
    uv sync --frozen --no-dev --no-install-project --python 3.11
    rm -rf /root/.cache
    chmod -R a+rX /opt/python /opt/venv /opt/ours-src

%test
    /opt/venv/bin/python -c 'import torch, torchvision, numpy, scipy, sklearn, open3d, sam2, transformers, open_clip, yaml, PIL; print("torch", torch.__version__, "tv", torchvision.__version__, "numpy", numpy.__version__, "transformers", transformers.__version__, "open_clip", open_clip.__version__, "open3d", open3d.__version__)'

%labels
    project 114_spatial_memory
    stack ubuntu22.04 py3.11 torch2.7.1+cu126 sam2-2b90b9f transformers4.57.1 open_clip3.3.0 (uv.lock)

%help
    apptainer exec --nv ours.sif /opt/venv/bin/python -m spatialmem.ours.v2 ...   (see hpc/slurm/ours_env.sh)
