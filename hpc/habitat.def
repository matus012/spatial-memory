Bootstrap: docker
From: ubuntu:22.04
# 114 Habitat image (task 002 step 1): habitat-sim 0.3.3 built from source, headless + EGL, no bullet, py3.10 (uv; 3.10 for the bundled pybind11).
# Plain ubuntu base (112/113 lesson: nvidia/cuda base libs shadow the host's); the NVIDIA EGL driver comes in via --nv.
# Build on the PERUN login node: hpc/build_habitat.sh (apptainer build --fakeroot).

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONUNBUFFERED=1
    export __EGL_VENDOR_LIBRARY_DIRS=/usr/share/glvnd/egl_vendor.d

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl git git-lfs build-essential cmake ninja-build \
        pkg-config libjpeg-dev libglm-dev libegl-dev libegl1 libgl1 libgl-dev libglvnd-dev libgles-dev libopengl0 \
        libx11-dev zlib1g-dev
    rm -rf /var/lib/apt/lists/*
    # glvnd needs a vendor ICD file to dispatch to the NVIDIA EGL library that `--nv` binds in
    mkdir -p /usr/share/glvnd/egl_vendor.d
    printf '{\n  "file_format_version" : "1.0.0",\n  "ICD" : { "library_path" : "libEGL_nvidia.so.0" }\n}\n' \
        > /usr/share/glvnd/egl_vendor.d/10_nvidia.json
    curl -LsSf https://astral.sh/uv/0.12.19/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy
    uv python install 3.10
    uv venv --seed --python 3.10 /opt/venv   # --seed: setup.py pip-installs magnum-bindings
    export PATH=/opt/venv/bin:$PATH
    uv pip install --python /opt/venv/bin/python "setuptools<70" wheel "cmake<4" "numpy<2" scipy pillow pyyaml plyfile \
        tqdm attrs gitpython imageio imageio-ffmpeg matplotlib numba numpy-quaternion "trimesh>=4,<5"   # trimesh: tight GT AABBs from GLBs
    mkdir -p /opt/build && cd /opt/build
    git clone --branch v0.3.3 --depth 1 https://github.com/facebookresearch/habitat-sim.git
    cd habitat-sim
    git submodule update --init --recursive --depth 1 --jobs 16
    export CMAKE_BUILD_PARALLEL_LEVEL=48 MAKEFLAGS=-j48
    /opt/venv/bin/python setup.py install --headless
    cd / && rm -rf /opt/build /root/.cache
    chmod -R a+rX /opt/python /opt/venv

%test
    /opt/venv/bin/python -c 'import habitat_sim, numpy, trimesh; print("habitat_sim", habitat_sim.__version__, "numpy", numpy.__version__, "trimesh", trimesh.__version__, "built_with_bullet", habitat_sim.built_with_bullet)'

%labels
    project 114_spatial_memory
    stack ubuntu22.04 py3.10 habitat-sim0.3.3-headless-egl

%help
    apptainer exec --nv habitat.sif /opt/venv/bin/python ...
